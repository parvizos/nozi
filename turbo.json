{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["APP_URL", "AUTH_SECRET", "DATABASE_URL", "LOG_LEVEL", "NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "env": [
        "ALLOW_DEMO_SEED",
        "APP_URL",
        "AUTH_SECRET",
        "DATABASE_URL",
        "DEMO_USER_PASSWORD",
        "LOG_LEVEL",
        "NODE_ENV",
        "PORT",
        "SESSION_COOKIE_PREFIX"
      ],
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
