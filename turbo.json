{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "ABANDONED_CART_RETENTION_DAYS",
    "CLEANUP_INTERVAL_MINUTES",
    "COURIER_LOCATION_RETENTION_DAYS",
    "ENABLE_DELIVERY_CODES",
    "ENABLE_DEV_OTP_RESPONSE",
    "IDEMPOTENCY_RETENTION_HOURS",
    "OTP_IP_LIMIT_PER_15_MINUTES",
    "OTP_MAX_ATTEMPTS",
    "OTP_PHONE_LIMIT_PER_15_MINUTES",
    "OTP_RESEND_COOLDOWN_SECONDS",
    "OTP_RETENTION_HOURS",
    "OTP_TTL_SECONDS",
    "OUTBOX_BASE_BACKOFF_SECONDS",
    "OUTBOX_BATCH_SIZE",
    "OUTBOX_MAX_ATTEMPTS",
    "OUTBOX_POLL_INTERVAL_MS",
    "OUTBOX_RETENTION_DAYS",
    "RATE_LIMIT_RETENTION_HOURS",
    "SESSION_RETENTION_DAYS",
    "SMS_API_KEY",
    "SMS_API_URL",
    "SMS_FROM",
    "SMS_PROVIDER",
    "SMS_REQUIRED",
    "STALE_ORDER_INTERVAL_SECONDS",
    "TRUST_PROXY",
    "TURNSTILE_MODE",
    "TURNSTILE_SECRET_KEY",
    "WORKER_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["APP_URL", "AUTH_SECRET", "DATABASE_URL", "LOG_LEVEL", "NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "env": [
        "ALLOW_DEMO_SEED",
        "APP_URL",
        "AUTH_SECRET",
        "DATABASE_URL",
        "DEMO_USER_PASSWORD",
        "LOG_LEVEL",
        "NODE_ENV",
        "PORT",
        "SESSION_COOKIE_PREFIX"
      ],
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
