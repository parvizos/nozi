generator client {
  provider     = "prisma-client"
  output       = "../generated/client"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum UserRoleCode {
  CUSTOMER
  SELLER
  COURIER
  ADMIN
  SUPER_ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SellerUserRole {
  OWNER
  MANAGER
  OPERATOR
}

enum StoreStatus {
  DRAFT
  ACTIVE
  PAUSED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  HIDDEN
  REJECTED
  ARCHIVED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  CREATED
  AWAITING_SELLER_CONFIRMATION
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  COURIER_ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERY_FAILED
  RESCHEDULED
  RETURNING_TO_STORE
  RETURNED_TO_STORE
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderActorType {
  CUSTOMER
  SELLER
  COURIER
  ADMIN
  SYSTEM
}

enum OrderStatusSource {
  UI
  API
  SYSTEM
  WEBHOOK
}

enum PaymentMethod {
  CASH
  TEST
  ONLINE
}

enum PaymentProviderCode {
  CASH
  TEST
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum LedgerOwnerType {
  PLATFORM
  SELLER
  COURIER
  EXTERNAL
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum CourierStatus {
  AVAILABLE
  BUSY
  OFFLINE
  SUSPENDED
}

enum CourierAssignmentStatus {
  ASSIGNED
  ACCEPTED
  ARRIVED_AT_STORE
  PICKED_UP
  ON_THE_WAY
  DELIVERY_FAILED
  RETURNING_TO_STORE
  RETURNED_TO_STORE
  DELIVERED
  CANCELLED
}

enum DeliveryFailureReason {
  RECIPIENT_UNAVAILABLE
  WRONG_ADDRESS
  RECIPIENT_REFUSED
  CANNOT_CONTACT
  ACCESS_PROBLEM
  OTHER
}

enum OtpPurpose {
  AUTH
  COURIER_ACTIVATION
  ACCOUNT_RECOVERY
}

enum OtpChallengeStatus {
  PENDING
  CONSUMED
  EXPIRED
  BLOCKED
  SUPERSEDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER
}

enum NotificationChannel {
  SMS
  EMAIL
  IN_APP
  WHATSAPP
  TELEGRAM
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  name                String     @map("display_name") @db.VarChar(160)
  email               String     @unique @db.Citext
  emailVerified       Boolean    @default(false) @map("email_verified")
  image               String?    @map("image_url")
  phoneNumber         String?    @unique @map("phone_e164") @db.VarChar(20)
  phoneNumberVerified Boolean    @default(false) @map("phone_number_verified")
  phoneVerifiedAt     DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  status              UserStatus @default(ACTIVE)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(3)

  accounts               Account[]
  sessions               Session[]
  roles                  UserRole[]              @relation("AssignedRoles")
  rolesGranted           UserRole[]              @relation("GrantedRoles")
  customerProfile        CustomerProfile?
  adminPermissions       UserAdminPermission[]   @relation("AdminPermissionSubjects")
  adminPermissionsGiven  UserAdminPermission[]   @relation("AdminPermissionGranters")
  auditLogs              AuditLog[]
  approvedSellers        Seller[]                @relation("SellerApprover")
  sellerMemberships      SellerUser[]
  favorites              Favorite[]
  moderatedProducts      Product[]               @relation("ProductModerator")
  carts                  Cart[]
  orders                 Order[]                 @relation("OrderCustomer")
  orderStatusChanges     OrderStatusHistory[]    @relation("OrderStatusChangedBy")
  idempotencyKeys        IdempotencyKey[]
  ledgerTransactions     LedgerTransaction[]     @relation("LedgerTransactionCreator")
  courierProfile         Courier?
  courierAssignmentsMade CourierAssignment[]     @relation("CourierAssignmentAdmin")
  adminNotesAuthored     AdminNote[]             @relation("AdminNoteAuthor")
  adminNotesCustomer     AdminNote[]             @relation("AdminNoteCustomer")
  courierInvitationsMade CourierInvitation[]     @relation("CourierInvitationCreator")
  commissionChangesMade  CommissionRateHistory[] @relation("CommissionRateChangedBy")
  cashSettlementsMade    CourierCashSettlement[] @relation("CourierCashSettlementCreator")
  notifications          Notification[]

  @@index([status, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("users")
}

model Country {
  id                  String   @id @default(uuid()) @db.Uuid
  isoCode             String   @unique @map("iso_code") @db.Char(2)
  name                String   @db.VarChar(120)
  defaultCurrencyCode String   @map("default_currency_code") @db.Char(3)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cities City[]

  @@map("countries")
}

model City {
  id           String   @id @default(uuid()) @db.Uuid
  countryId    String   @map("country_id") @db.Uuid
  name         String   @db.VarChar(120)
  slug         String   @db.VarChar(140)
  timezone     String   @db.VarChar(64)
  currencyCode String   @map("currency_code") @db.Char(3)
  locale       String   @default("ru-TJ") @db.VarChar(16)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  country        Country        @relation(fields: [countryId], references: [id], onDelete: Restrict)
  stores         Store[]
  storeAddresses StoreAddress[]
  orders         Order[]

  @@unique([countryId, slug])
  @@index([isActive, name])
  @@map("cities")
}

model Seller {
  id                    String       @id @default(uuid()) @db.Uuid
  legalName             String       @map("legal_name") @db.VarChar(200)
  publicName            String       @map("public_name") @db.VarChar(160)
  status                SellerStatus @default(PENDING)
  supportEmail          String?      @map("support_email") @db.Citext
  supportPhoneE164      String?      @map("support_phone_e164") @db.VarChar(20)
  taxIdentifier         String?      @map("tax_identifier") @db.VarChar(80)
  documentsStatus       String       @default("PENDING") @map("documents_status") @db.VarChar(32)
  defaultCommissionRate Decimal      @default(15) @map("default_commission_rate") @db.Decimal(5, 2)
  approvedAt            DateTime?    @map("approved_at") @db.Timestamptz(3)
  approvedByUserId      String?      @map("approved_by_user_id") @db.Uuid
  rejectionReason       String?      @map("rejection_reason") @db.VarChar(500)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?    @map("deleted_at") @db.Timestamptz(3)

  approvedBy            User?                   @relation("SellerApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  users                 SellerUser[]
  stores                Store[]
  commissions           Commission[]
  commissionRateHistory CommissionRateHistory[]
  adminNotes            AdminNote[]

  @@index([status, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("sellers")
}

model SellerUser {
  sellerId   String         @map("seller_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  sellerRole SellerUserRole @default(OPERATOR) @map("seller_role")
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sellerId, userId])
  @@index([userId, isActive])
  @@index([sellerId, isActive])
  @@map("seller_users")
}

model Store {
  id                        String      @id @default(uuid()) @db.Uuid
  sellerId                  String      @map("seller_id") @db.Uuid
  cityId                    String      @map("city_id") @db.Uuid
  name                      String      @db.VarChar(160)
  slug                      String      @db.VarChar(180)
  description               String
  logoObjectKey             String?     @map("logo_object_key") @db.VarChar(500)
  coverImageObjectKey       String?     @map("cover_image_object_key") @db.VarChar(500)
  phoneE164                 String      @map("phone_e164") @db.VarChar(20)
  status                    StoreStatus @default(DRAFT)
  minimumOrderAmount        Decimal     @default(0) @map("minimum_order_amount") @db.Decimal(12, 2)
  deliveryFeeAmount         Decimal     @default(25) @map("delivery_fee_amount") @db.Decimal(12, 2)
  defaultPreparationMinutes Int         @default(60) @map("default_preparation_minutes")
  ratingAverage             Decimal     @default(0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount               Int         @default(0) @map("rating_count")
  deliveryEnabled           Boolean     @default(true) @map("delivery_enabled")
  isOpen                    Boolean     @default(true) @map("is_open")
  isActive                  Boolean     @default(true) @map("is_active")
  isTemporarilyPaused       Boolean     @default(false) @map("is_temporarily_paused")
  pauseReason               String?     @map("pause_reason") @db.VarChar(300)
  createdAt                 DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                 DateTime?   @map("deleted_at") @db.Timestamptz(3)

  seller       Seller             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  city         City               @relation(fields: [cityId], references: [id], onDelete: Restrict)
  address      StoreAddress?
  products     Product[]
  carts        Cart[]
  orders       Order[]
  openingHours StoreOpeningHour[]

  @@unique([cityId, slug])
  @@index([sellerId, status])
  @@index([cityId, status, isActive])
  @@index([status, ratingAverage(sort: Desc)])
  @@index([deletedAt])
  @@map("stores")
}

model StoreOpeningHour {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week") @db.SmallInt
  isClosed  Boolean  @default(false) @map("is_closed")
  opensAt   String?  @map("opens_at") @db.VarChar(5)
  closesAt  String?  @map("closes_at") @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dayOfWeek])
  @@index([storeId])
  @@map("store_opening_hours")
}

model StoreAddress {
  storeId    String   @id @map("store_id") @db.Uuid
  cityId     String   @map("city_id") @db.Uuid
  line1      String   @db.VarChar(240)
  line2      String?  @db.VarChar(240)
  postalCode String?  @map("postal_code") @db.VarChar(20)
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  city  City  @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@index([cityId])
  @@map("store_addresses")
}

model Category {
  id             String    @id @default(uuid()) @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  name           String    @db.VarChar(120)
  slug           String    @unique @db.VarChar(140)
  description    String?
  imageObjectKey String?   @map("image_object_key") @db.VarChar(500)
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, isActive, sortOrder])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id                     String        @id @default(uuid()) @db.Uuid
  storeId                String        @map("store_id") @db.Uuid
  categoryId             String        @map("category_id") @db.Uuid
  name                   String        @db.VarChar(200)
  slug                   String        @unique @db.VarChar(220)
  description            String
  status                 ProductStatus @default(DRAFT)
  price                  Decimal       @db.Decimal(12, 2)
  compareAtPrice         Decimal?      @map("compare_at_price") @db.Decimal(12, 2)
  currencyCode           String        @map("currency_code") @db.Char(3)
  trackInventory         Boolean       @default(true) @map("track_inventory")
  stockQuantity          Int           @default(0) @map("stock_quantity")
  reservedQuantity       Int           @default(0) @map("reserved_quantity")
  preparationTimeMinutes Int?          @map("preparation_time_minutes")
  ratingAverage          Decimal       @default(0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount            Int           @default(0) @map("rating_count")
  isFeatured             Boolean       @default(false) @map("is_featured")
  moderatedAt            DateTime?     @map("moderated_at") @db.Timestamptz(3)
  moderatedByUserId      String?       @map("moderated_by_user_id") @db.Uuid
  moderationNote         String?       @map("moderation_note") @db.VarChar(500)
  version                Int           @default(1)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?     @map("deleted_at") @db.Timestamptz(3)

  store                 Store                  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  moderatedBy           User?                  @relation("ProductModerator", fields: [moderatedByUserId], references: [id], onDelete: SetNull)
  images                ProductImage[]
  variants              ProductVariant[]
  favorites             Favorite[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  inventoryReservations InventoryReservation[]

  @@unique([storeId, slug])
  @@index([categoryId, status, createdAt(sort: Desc)])
  @@index([storeId, status])
  @@index([status, ratingAverage(sort: Desc)])
  @@index([status, isFeatured, createdAt(sort: Desc)])
  @@index([price])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  objectKey String    @map("object_key") @db.VarChar(500)
  altText   String    @map("alt_text") @db.VarChar(240)
  sortOrder Int       @default(0) @map("sort_order")
  isPrimary Boolean   @default(false) @map("is_primary")
  width     Int?
  height    Int?
  mimeType  String?   @map("mime_type") @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId, isPrimary])
  @@map("product_images")
}

model ProductVariant {
  id               String    @id @default(uuid()) @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  name             String    @db.VarChar(160)
  sku              String?   @db.VarChar(100)
  priceDelta       Decimal   @default(0) @map("price_delta") @db.Decimal(12, 2)
  absolutePrice    Decimal?  @map("absolute_price") @db.Decimal(12, 2)
  stockQuantity    Int       @default(0) @map("stock_quantity")
  reservedQuantity Int       @default(0) @map("reserved_quantity")
  isActive         Boolean   @default(true) @map("is_active")
  sortOrder        Int       @default(0) @map("sort_order")
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems             CartItem[]
  orderItems            OrderItem[]
  inventoryReservations InventoryReservation[]

  @@unique([productId, sku])
  @@index([productId, isActive, sortOrder])
  @@map("product_variants")
}

model Favorite {
  customerUserId String   @map("customer_user_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  customer User    @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([customerUserId, productId])
  @@index([productId])
  @@map("favorites")
}

model Cart {
  id             String     @id @default(uuid()) @db.Uuid
  customerUserId String     @map("customer_user_id") @db.Uuid
  storeId        String     @map("store_id") @db.Uuid
  currencyCode   String     @map("currency_code") @db.Char(3)
  status         CartStatus @default(ACTIVE)
  expiresAt      DateTime?  @map("expires_at") @db.Timestamptz(3)
  version        Int        @default(1)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer User       @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  store    Store      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items    CartItem[]

  @@index([customerUserId, status])
  @@index([storeId, status])
  @@map("carts")
}

model CartItem {
  id                String   @id @default(uuid()) @db.Uuid
  cartId            String   @map("cart_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  productVariantId  String?  @map("product_variant_id") @db.Uuid
  quantity          Int
  unitPriceSnapshot Decimal  @map("unit_price_snapshot") @db.Decimal(12, 2)
  currencyCode      String   @map("currency_code") @db.Char(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([cartId])
  @@index([productId])
  @@index([productVariantId])
  @@map("cart_items")
}

model Order {
  id                           String        @id @default(uuid()) @db.Uuid
  orderNumber                  String        @unique @map("order_number") @db.VarChar(32)
  customerUserId               String        @map("customer_user_id") @db.Uuid
  storeId                      String        @map("store_id") @db.Uuid
  cityId                       String        @map("city_id") @db.Uuid
  status                       OrderStatus   @default(CREATED)
  version                      Int           @default(1)
  currencyCode                 String        @map("currency_code") @db.Char(3)
  itemsSubtotal                Decimal       @map("items_subtotal") @db.Decimal(12, 2)
  deliveryFee                  Decimal       @map("delivery_fee") @db.Decimal(12, 2)
  discountTotal                Decimal       @default(0) @map("discount_total") @db.Decimal(12, 2)
  grandTotal                   Decimal       @map("grand_total") @db.Decimal(12, 2)
  buyerName                    String        @map("buyer_name") @db.VarChar(160)
  buyerPhoneE164               String        @map("buyer_phone_e164") @db.VarChar(20)
  recipientName                String        @map("recipient_name") @db.VarChar(160)
  recipientPhoneE164           String        @map("recipient_phone_e164") @db.VarChar(20)
  giftMessage                  String?       @map("gift_message") @db.VarChar(500)
  anonymousDelivery            Boolean       @default(false) @map("anonymous_delivery")
  requestedDeliveryDate        DateTime      @map("requested_delivery_date") @db.Date
  requestedDeliveryWindowStart DateTime      @map("requested_delivery_window_start") @db.Time(0)
  requestedDeliveryWindowEnd   DateTime      @map("requested_delivery_window_end") @db.Time(0)
  deliveryTimezone             String        @default("Asia/Dushanbe") @map("delivery_timezone") @db.VarChar(64)
  customerNote                 String?       @map("customer_note") @db.VarChar(500)
  paymentMethod                PaymentMethod @map("payment_method")
  placedAt                     DateTime?     @map("placed_at") @db.Timestamptz(3)
  confirmedAt                  DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  deliveredAt                  DateTime?     @map("delivered_at") @db.Timestamptz(3)
  cancelledAt                  DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancellationReasonCode       String?       @map("cancellation_reason_code") @db.VarChar(80)
  cancellationNote             String?       @map("cancellation_note") @db.VarChar(500)
  createdAt                    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer              User                   @relation("OrderCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  store                 Store                  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  city                  City                   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  deliveryAddress       OrderDeliveryAddress?
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  inventoryReservations InventoryReservation[]
  payment               Payment?
  commission            Commission?
  courierAssignments    CourierAssignment[]
  adminNotes            AdminNote[]
  deliveryProof         DeliveryProof?

  @@index([customerUserId, createdAt(sort: Desc)])
  @@index([storeId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([cityId, requestedDeliveryDate, status])
  @@map("orders")
}

model OrderDeliveryAddress {
  orderId      String   @id @map("order_id") @db.Uuid
  cityName     String   @map("city_name") @db.VarChar(120)
  countryCode  String   @map("country_code") @db.Char(2)
  line1        String   @db.VarChar(240)
  apartment    String?  @db.VarChar(40)
  entrance     String?  @db.VarChar(40)
  floor        String?  @db.VarChar(20)
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  deliveryNote String?  @map("delivery_note") @db.VarChar(500)
