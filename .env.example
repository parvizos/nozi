# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://nozi:nozi_dev_only@localhost:5432/nozi?schema=public

# Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_PREFIX=nozi

# Development seed. Never enable in production.
ALLOW_DEMO_SEED=false
DEMO_USER_PASSWORD=replace-for-local-development-only
