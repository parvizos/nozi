# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info
ENABLE_TEST_PAYMENTS=false
ENABLE_DELIVERY_CODES=false
DELIVERY_CODE_TTL_MINUTES=240
DELIVERY_CODE_MAX_ATTEMPTS=5
COURIER_INVITATION_TTL_HOURS=24
SELLER_CONFIRMATION_SLA_MINUTES=15
MAX_DELIVERY_HORIZON_DAYS=30
MAX_PENDING_CASH_ORDERS_PER_CUSTOMER=3
ENABLE_DEV_OTP_RESPONSE=false
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PHONE_LIMIT_PER_15_MINUTES=5
OTP_IP_LIMIT_PER_15_MINUTES=20
TRUST_PROXY=false
TURNSTILE_MODE=disabled
# TURNSTILE_SECRET_KEY=

# Notifications and worker
SMS_PROVIDER=console
SMS_REQUIRED=false
SMS_FROM=NOZI
# SMS_API_URL=https://sms-provider.example/v1/messages
# SMS_API_KEY=
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BASE_BACKOFF_SECONDS=10
WORKER_PORT=3001
STALE_ORDER_INTERVAL_SECONDS=60
CLEANUP_INTERVAL_MINUTES=60
OTP_RETENTION_HOURS=24
RATE_LIMIT_RETENTION_HOURS=24
IDEMPOTENCY_RETENTION_HOURS=168
ABANDONED_CART_RETENTION_DAYS=30
SESSION_RETENTION_DAYS=30
COURIER_LOCATION_RETENTION_DAYS=30
OUTBOX_RETENTION_DAYS=30

# PostgreSQL
DATABASE_URL=postgresql://nozi:nozi_dev_only@localhost:5432/nozi?schema=public

# Tests refuse to run without all three safeguards.
TEST_DATABASE_URL=postgresql://nozi:nozi_dev_only@localhost:5432/nozi_test_local?schema=public
ALLOW_TEST_DATABASE=false

# Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_PREFIX=nozi

# Development seed. Never enable in production.
ALLOW_DEMO_SEED=false
DEMO_USER_PASSWORD=replace-for-local-development-only
